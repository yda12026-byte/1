DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
FUYAO_API_KEY=
FUYAO_BASE_URL=https://fuyao.aicubes.cn
IFIND_MCP_AUTH_TOKEN=
IFIND_MCP_URL=https://api-mcp.51ifind.com:8643/ds-mcp-servers/hexin-ifind-ds-mcp
DIAGNOSIS_SNAPSHOT_PATH=
# 留空时读取 DIAGNOSIS_SNAPSHOT_PATH 同目录下的 product_snapshot_002466.json
DIAGNOSIS_PRODUCT_SNAPSHOT_PATH=
# 决策 0020 线上方案：设置 DIAGNOSIS_COS_BUCKET 后，服务启动时从私有 COS 下载两份快照（不使用挂载路径）
DIAGNOSIS_COS_BUCKET=
DIAGNOSIS_COS_REGION=ap-shanghai
DIAGNOSIS_COS_PREFIX=snapshots/
DIAGNOSIS_COS_SECRET_ID=
DIAGNOSIS_COS_SECRET_KEY=
DIAGNOSIS_SNAPSHOT_DIR=/tmp/snapshots
